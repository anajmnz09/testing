# Casos de Uso IA — copia este archivo a `ia/.env` (o agrega estas líneas al `.env` raíz) y completa la key.
# Aquí va SOLO lo nuevo de Casos IA. El acceso a la aplicación (BASE_URL, APP_USERNAME, PASSWORD) es el del `.env` raíz del proyecto:
# no se repite ni se redefine aquí.
# El modelo se usa por la API de OpenAI (Responses): no hace falta instalar nada de OpenAI ni de Claude localmente.
# `ia/.env` está en .gitignore: la key nunca se sube al repositorio ni llega al navegador del Panel.

# Obligatoria: credencial de la API de OpenAI.
OPENAI_API_KEY=

# Opcionales
# OPENAI_MODEL=gpt-6.1-sol                  # modelo a usar
# OPENAI_REASONING_EFFORT=                  # esfuerzo de razonamiento (según el modelo: low, medium, high…)
# OPENAI_BASE_URL=https://api.openai.com    # endpoint alterno / proxy
# IA_MAX_ACCIONES=40                        # máximo de acciones por ejecución
# IA_MAX_MINUTOS=20                         # tiempo máximo por ejecución
